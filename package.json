{
  "name": "freeagent-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for FreeAgent accounting — bank reconciliation, expenses, mileage claims and receipt management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "freeagent-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "freeagent",
    "accounting",
    "bank-reconciliation",
    "expenses",
    "mileage",
    "bookkeeping",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Oxygen Bubbles Limited",
  "repository": {
    "type": "git",
    "url": "https://github.com/OxygenBubbles/freeagent-mcp-server.git"
  },
  "homepage": "https://github.com/OxygenBubbles/freeagent-mcp-server#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
